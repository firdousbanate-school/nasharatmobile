+vi.mock("@/lib/logger/logError", () => ({ logError: vi.fn() }));
+vi.mock("@/lib/supabase", () => ({
+  createSupabaseServerClient: vi.fn().mockResolvedValue({ marker: "supabase" }),
+}));
