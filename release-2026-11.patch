--- /dev/null
+++ b/src/components/calendar/CalendarMobileDayCell.tsx
@@ -0,0 +1,49 @@
+import { cn } from "@/lib/cn";
+
+/** One day in the phone month grid: number plus up to three dots for items on that day. */
+export function CalendarMobileDayCell({
+  day,
+  label,
+  isToday,
+  isSelected,
+  isWeekend = false,
+  itemCount,
+  onSelect,
+}: {
+  day: number;
+  label: string;
+  isToday: boolean;
+  isSelected: boolean;
+  isWeekend?: boolean;
+  itemCount: number;
+  onSelect: () => void;
+}) {
+  return (
+    <button
+      type="button"
+      onClick={onSelect}
+      aria-pressed={isSelected}
+      aria-label={label}
+      className={cn(
+        "flex h-12 flex-col items-center justify-center gap-0.5 rounded-lg text-sm font-medium active:bg-muted",
+        isWeekend ? "text-amber-600 dark:text-amber-400" : "text-foreground",
+      )}
+    >
+      <span
+        className={cn(
+          "flex size-8 items-center justify-center rounded-full",
+          isSelected
+            ? "bg-primary text-primary-foreground"
+            : isToday && "text-primary ring-1 ring-primary",
+        )}
+      >
+        {day}
+      </span>
+      <span className="flex h-1 gap-0.5" aria-hidden="true">
+        {Array.from({ length: Math.min(itemCount, 3) }, (_, i) => (
+          <span key={i} className="size-1 rounded-full bg-primary/70" />
+        ))}
+      </span>
+    </button>
+  );
+}
diff --git a/src/components/calendar/CalendarMobileMonth.tsx b/src/components/calendar/CalendarMobileMonth.tsx
new file mode 100644
index 0000000..cef4f3d
--- /dev/null
+++ b/src/components/calendar/CalendarMobileMonth.tsx
@@ -0,0 +1,78 @@
+"use client";
+
+import { useState } from "react";
+import { useLocale } from "next-intl";
+import { filterItemsByDay } from "@/lib/calendar/filterItemsByDay";
+import { isSameDay } from "@/lib/calendar/isSameDay";
+import { isWeekendDay } from "@/lib/calendar/isWeekendDay";
+import { CalendarListView } from "./CalendarListView";
+import { CalendarMobileDayCell } from "./CalendarMobileDayCell";
+import { CalendarMobileMonthHeader } from "./CalendarMobileMonthHeader";
+import { CalendarMobileWeekdays } from "./CalendarMobileWeekdays";
+import type { UnifiedCalendarItem } from "@/lib/calendar/types";
+
+/** Phone month view: compact grid with dots, and the selected day's items listed below. */
+export function CalendarMobileMonth({
+  items,
+  canManage,
+  onSelectItem,
+}: {
+  items: UnifiedCalendarItem[];
+  canManage: boolean;
+  onSelectItem?: (item: UnifiedCalendarItem) => void;
+}) {
+  const intlLocale = useLocale() === "ar" ? "ar-EG" : "en-US";
+  const [currentDate, setCurrentDate] = useState(() => new Date());
+  const [selected, setSelected] = useState(() => new Date());
+
+  const year = currentDate.getFullYear();
+  const month = currentDate.getMonth();
+  const firstDayIndex = new Date(year, month, 1).getDay();
+  const totalDays = new Date(year, month + 1, 0).getDate();
+  const today = new Date();
+
+  const goToMonth = (target: Date) => {
+    setCurrentDate(target);
+    setSelected(target);
+  };
+
+  return (
+    <div className="space-y-4">
+      <div className="rounded-xl border border-border bg-card p-3 shadow-xs">
+        <CalendarMobileMonthHeader
+          currentDate={currentDate}
+          onPrev={() => goToMonth(new Date(year, month - 1, 1))}
+          onNext={() => goToMonth(new Date(year, month + 1, 1))}
+          onToday={() => goToMonth(new Date())}
+        />
+        <CalendarMobileWeekdays />
+        <div className="mt-1 grid grid-cols-7">
+          {Array.from({ length: firstDayIndex }, (_, i) => (
+            <span key={`blank-${i}`} />
+          ))}
+          {Array.from({ length: totalDays }, (_, i) => {
+            const date = new Date(year, month, i + 1);
+            return (
+              <CalendarMobileDayCell
+                key={i}
+                day={i + 1}
+                label={date.toLocaleDateString(intlLocale, { dateStyle: "full" })}
+                isToday={isSameDay(date, today)}
+                isSelected={isSameDay(date, selected)}
+                isWeekend={isWeekendDay(date)}
+                itemCount={filterItemsByDay(items, date).length}
+                onSelect={() => setSelected(date)}
+              />
+            );
+          })}
+        </div>
+      </div>
+
+      <CalendarListView
+        items={filterItemsByDay(items, selected)}
+        canManage={canManage}
+        onSelectItem={onSelectItem}
+      />
+    </div>
+  );
+}
