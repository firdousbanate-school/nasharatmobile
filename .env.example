# Copy to .env.local and fill with real values. Never commit .env.local.

# Supabase (Project Settings → API)
# Publishable key (replaces the legacy "anon" key) — safe in the browser under RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-publishable-key

# Secret key (replaces the legacy "service_role" key) — SERVER-ONLY.
# Never prefix with NEXT_PUBLIC_. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-secret-key

# School
# IANA timezone used for date rendering and deadline calculations.
SCHOOL_TIMEZONE=Asia/Kuwait

# Public base URL of this deployment. Auth emails (password reset) are built
# from this value, never from request headers. It must match the "Site URL" and
# be an allowed redirect in Supabase Auth → URL Configuration.
APP_URL=http://localhost:3000

# First platform-owner bootstrap (Settings/dashboard "claim owner").
# In production at least one of these must be set or claiming is disabled;
# with the secret set, the claim form requires it, and with the email set only
# that account may claim the owner role.
PLATFORM_BOOTSTRAP_SECRET=
PLATFORM_OWNER_EMAIL=

# Shared secret for /api/keepalive. The Vercel cron in vercel.json sends it as
# `Authorization: Bearer $CRON_SECRET` automatically. Unset in production means
# the endpoint rejects every call (fail closed) instead of being public.
CRON_SECRET=

# Shared secret for /api/health?deep=1. Protects database health probes from
# public denial-of-service / resource exhaustion. Falls back to CRON_SECRET if unset.
HEALTH_CHECK_SECRET=

# Secret for /api/bypass. Allows authorized previewers/operators to bypass the
# "under construction" landing screen on Vercel preview deployments.
UNDER_CONSTRUCTION_BYPASS_SECRET=

# Set to "true" in production on Vercel to disable the holding page and launch the portal publicly.
DISABLE_UNDER_CONSTRUCTION=false

# Optional error collector. With no URL, server and client errors are written
# to the structured console log only, each with a correlation id.
# A Sentry/OTLP-compatible HTTP endpoint can be set to forward the same payload.
ERROR_REPORTING_URL=
ERROR_REPORTING_TOKEN=

# Build identifier reported by /api/health. CI sets GIT_COMMIT_SHA; Vercel sets
# VERCEL_GIT_COMMIT_SHA automatically.
GIT_COMMIT_SHA=
